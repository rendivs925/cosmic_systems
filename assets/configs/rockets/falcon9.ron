// Falcon 9 (Block 5) - two-stage kerolox medium-lift vehicle.
//
// Numbers are chosen to match the hardcoded test fixture
// (`domain/entities/rocket.rs :: Rocket::falcon9_test_fixture()`), which pins the original
// simulator aggregates: 22.2 t dry (18.0 t stage 1 + 4.2 t stage 2),
// 120.0 t propellant (90.0 t + 30.0 t), 7 607 kN liftoff thrust across nine
// Merlin 1D engines, ISP 282 s (SL) / 311 s (vac), 5 deg TVC gimbal, 3.7 m
// core diameter; stage lengths 41.2 m / 13.2 m within the 70 m stack. Engine
// stations are representative stage-local values: nine engines on a 1.2 m
// octaweb ring at the stage-1 lower cylinder end (y = -20.6 m), and one
// Merlin Vacuum at the stage-2 lower cylinder end (y = -6.6 m).
// ISP 311 s (SL) / 348 s (vac).
//
// Sources (rough public figures): SpaceX Falcon 9 User Guide (2018-2021),
// SpaceX press materials; per-engine thrust derived from the 7 607 kN
// aggregate retained by the simulator. Ignition budgets below are conservative
// catalog assumptions for this simulator, not asserted operational limits.
// The dated source byte is not yet pinned, so no checksum is claimed.

(
    vehicles: [
        (
            name: "Falcon 9",
            basis: Representative,
            provenance: (
                manufacturer: "SpaceX",
                primary_source: (
                    title: "Falcon 9 Payload User's Guide",
                    source_url: "https://www.spacex.com/vehicles/falcon-9/",
                ),
                representative_rationale: "The retained simulator fixture and rough public figures include representative mass splits, engine stations, ignition limits, and landing gear; the dated source byte is not yet pinned.",
            ),
            diameter_m: 3.7,
            height_m: 70.0,
            stages: [
                (
                    // Nine Merlin 1D engines on the octaweb ring (radius
                    // 1.2 m at stage-local y = -20.6 m); per-engine thrust =
                    // 7 607 kN / 9.
                    name: "Falcon 9 Stage 1",
                    basis: Representative,
                    diameter_m: 3.7,
                    height_m: 41.2,
                    dry_mass_kg: 18_000.0,
                    propellant_mass_kg: 90_000.0,
                    recovery_propellant_reserve_kg: Some(15_000.0),
                    // Falcon 9's deployable legs are Stage 1 recovery hardware.
                    landing_legs: (
                        basis: Representative,
                        count: 4,
                        base_radius_m: 4.5,
                        stroke_m: 3.0,
                        max_landing_mass_kg: 30_000.0,
                        deploy_altitude_m: 100.0,
                    ),
                    engines: (
                        basis: Representative,
                        values: [
                        (
                            position: (1.2, -20.6, 0.0),
                            thrust_axis: (0.0, 1.0, 0.0),
                            isp_sl: 282.0,
                            isp_vac: 311.0,
                            gimbal_range_deg: 5.0,
                            rated_thrust_n: 845_222.2,
                            thrust_reference: SeaLevel,
                            max_ignitions: 3,
