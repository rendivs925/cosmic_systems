// Falcon 9 (Block 5) - two-stage kerolox medium-lift vehicle.
//
// Public Block 5 figures, kept internally coherent:
//   - liftoff mass ~549.5 t: stage 1 dry 25.6 t + 411.0 t propellant,
//     stage 2 dry 4.0 t + 107.0 t propellant, fairing 1.9 t
//   - 7 607 kN liftoff thrust across nine Merlin 1D engines (845.2 kN each),
//     ISP 282 s (SL) / 311 s (vac), 5 deg TVC gimbal
//   - one Merlin Vacuum, 981 kN, ISP 348 s (vac)
//   - 3.7 m core diameter; stage lengths 41.2 m / 13.2 m within the 70 m stack
//
// The previous definition kept the 7 607 kN aggregate but only 120 t of
// propellant, which made the vehicle 5.4 g at liftoff and unable to follow any
// realistic gravity turn. The controller's PID gains are normalized to a
// ~549 t reference, so this restores the mass the attitude loop was designed
// for.
//
// Engine stations are representative stage-local values: nine engines on a
// 1.2 m octaweb ring at the stage-1 lower cylinder end (y = -20.6 m), and one
// Merlin Vacuum at the stage-2 lower cylinder end (y = -6.6 m).
//
// Sources: SpaceX Falcon 9 public vehicle figures (liftoff mass, propellant
// loads, Merlin thrust/ISP, Merlin Vacuum thrust/ISP) as published in the
// Falcon 9 Payload User's Guide era (2018-2021) and SpaceX vehicle pages.
// Ignition budgets, the 15 t recovery reserve and the landing-leg mass limit
// are conservative simulator assumptions, not asserted operational limits.
//
// Source identity is deliberately not byte-pinned. The cited URL is SpaceX's
// mutable vehicle page (HTML whose content changes without a versioned,
// immutable edition), and this offline workspace holds no retrieved snapshot.
// Hashing a live page would pin an artifact a later reader cannot retrieve, so
// no SHA-256 is claimed and the entry stays Representative. Trajectory
// reproducibility is pinned separately by the loaded configuration's SHA-256,
// which every simulation run identity records.

(
    vehicles: [
        (
            name: "Falcon 9",
            basis: Representative,
            provenance: (
                manufacturer: "SpaceX",
                primary_source: (
                    title: "Falcon 9 Payload User's Guide",
                    source_url: "https://www.spacex.com/vehicles/falcon-9/",
                ),
                representative_rationale: "Public Block 5 masses, propellant loads, and Merlin/Merlin Vacuum thrust and ISP; engine stations, ignition budgets, recovery reserve, and landing-gear limits are simulator-representative. The source byte is not byte-pinned: the cited page is mutable vendor HTML with no dated immutable edition and no retrieved snapshot, so no checksum is claimed.",
            ),
            diameter_m: 3.7,
            height_m: 70.0,
            stages: [
                (
                    // Nine Merlin 1D engines: one center engine plus eight
                    // ring engines at radius 1.2 m, all at stage-local
                    // y = -20.6 m; per-engine thrust = 7 607 kN / 9. The
                    // center engine is first so a one-engine landing burn
                    // selects it.
                    name: "Falcon 9 Stage 1",
                    basis: Representative,
                    diameter_m: 3.7,
                    height_m: 41.2,
                    dry_mass_kg: 25_600.0,
                    propellant_mass_kg: 411_000.0,
                    recovery_propellant_reserve_kg: Some(15_000.0),
                    // Falcon 9's deployable legs are Stage 1 recovery hardware.
                    landing_legs: (
                        basis: Representative,
                        count: 4,
                        base_radius_m: 4.5,
                        stroke_m: 3.0,
                        max_landing_mass_kg: 45_000.0,
                        deploy_altitude_m: 100.0,
                    ),
                    // Four 4 ft x 5 ft lattice fins near the top of the stage.
                    // The normal-force slope is a representative flat-surface
                    // scale, not a wind-tunnel table. They are inserted only on
                    // the recovering stage, so the ascent authority is unchanged.
                    grid_fins: (
                        basis: Representative,
                        count: 4,
                        fin_area_m2: 1.86,
                        radial_arm_m: 2.4,
                        axial_station_m: 18.5,
                        max_deflection_deg: 30.0,
                        normal_force_coefficient_per_rad: 2.0,
                    ),
                    engines: (
                        basis: Representative,
                        values: [
                        // Center Merlin: gimbal deflection produces torque
                        // through the axial offset, with no radial thrust offset.
                        (
                            position: (0.0, -20.6, 0.0),
                            thrust_axis: (0.0, 1.0, 0.0),
                            isp_sl: 282.0,
                            isp_vac: 311.0,
                            gimbal_range_deg: 5.0,
                            rated_thrust_n: 845_222.2,
                            thrust_reference: SeaLevel,
                            // Ascent plus boostback, entry and landing restarts.
                            max_ignitions: 5,
                        ),
                        (
                            position: (1.200000, -20.6, 0.000000),
                            thrust_axis: (0.0, 1.0, 0.0),
                            isp_sl: 282.0,
                            isp_vac: 311.0,
                            gimbal_range_deg: 5.0,
                            rated_thrust_n: 845_222.2,
                            thrust_reference: SeaLevel,
                            max_ignitions: 5,
                        ),
                        (
                            position: (-1.200000, -20.6, 0.000000),
                            thrust_axis: (0.0, 1.0, 0.0),
                            isp_sl: 282.0,
                            isp_vac: 311.0,
                            gimbal_range_deg: 5.0,
                            rated_thrust_n: 845_222.2,
                            thrust_reference: SeaLevel,
                            max_ignitions: 5,
                        ),
                        (
                            position: (0.848528, -20.6, 0.848528),
                            thrust_axis: (0.0, 1.0, 0.0),
                            isp_sl: 282.0,
                            isp_vac: 311.0,
                            gimbal_range_deg: 5.0,
                            rated_thrust_n: 845_222.2,
                            thrust_reference: SeaLevel,
                            max_ignitions: 5,
                        ),
                        (
                            position: (-0.848528, -20.6, -0.848528),
                            thrust_axis: (0.0, 1.0, 0.0),
                            isp_sl: 282.0,
                            isp_vac: 311.0,
                            gimbal_range_deg: 5.0,
                            rated_thrust_n: 845_222.2,
                            thrust_reference: SeaLevel,
                            max_ignitions: 5,
                        ),
                        (
                            position: (0.000000, -20.6, 1.200000),
                            thrust_axis: (0.0, 1.0, 0.0),
                            isp_sl: 282.0,
                            isp_vac: 311.0,
                            gimbal_range_deg: 5.0,
                            rated_thrust_n: 845_222.2,
                            thrust_reference: SeaLevel,
                            max_ignitions: 5,
                        ),
                        (
                            position: (-0.000000, -20.6, -1.200000),
                            thrust_axis: (0.0, 1.0, 0.0),
                            isp_sl: 282.0,
                            isp_vac: 311.0,
                            gimbal_range_deg: 5.0,
                            rated_thrust_n: 845_222.2,
                            thrust_reference: SeaLevel,
                            max_ignitions: 5,
                        ),
                        (
                            position: (-0.848528, -20.6, 0.848528),
                            thrust_axis: (0.0, 1.0, 0.0),
                            isp_sl: 282.0,
                            isp_vac: 311.0,
                            gimbal_range_deg: 5.0,
                            rated_thrust_n: 845_222.2,
                            thrust_reference: SeaLevel,
                            max_ignitions: 5,
                        ),
                        (
                            position: (0.848528, -20.6, -0.848528),
                            thrust_axis: (0.0, 1.0, 0.0),
                            isp_sl: 282.0,
                            isp_vac: 311.0,
                            gimbal_range_deg: 5.0,
                            rated_thrust_n: 845_222.2,
                            thrust_reference: SeaLevel,
                            max_ignitions: 5,
                        ),
                        ],
                    ),
                ),
                (
                    name: "Falcon 9 Stage 2",
                    basis: Representative,
                    diameter_m: 3.7,
                    height_m: 13.2,
                    dry_mass_kg: 4_000.0,
                    propellant_mass_kg: 107_000.0,
                    fairing: (
                        basis: Representative,
                        dry_mass_kg: 1_900.0,
                    ),
                    engines: (
                        basis: Representative,
                        values: [
                        // Single Merlin Vacuum at the stage-local lower end.
                        (
                            position: (0.0, -6.6, 0.0),
                            thrust_axis: (0.0, 1.0, 0.0),
                            isp_sl: 311.0,
                            isp_vac: 348.0,
                            gimbal_range_deg: 5.0,
                            rated_thrust_n: 981_000.0,
                            thrust_reference: Vacuum,
                            // The upper stage relights for insertion and any
                            // trim burn; the ascent start plus the post-staging
                            // restart already consume two.
                            max_ignitions: 3,
                        ),
                        ],
                    ),
                ),
            ],
        ),
    ],
)
