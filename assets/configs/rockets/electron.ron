// Electron - two-stage kerolox small-lift launch vehicle (Rocket Lab).
//
// Simplification: nine sea-level Rutherfords in a 1-center + 8-ring octaweb
// at representative body-frame stations; one Rutherford Vacuum on stage 2.
// Electric-pump engines allow deep throttling and air restarts.
//
// Sources (rough public figures): Rocket Lab Payload User Guide - vehicle
// 1.2 m diameter x 18 m; liftoff mass ~13 t with ~9.25 t stage-1 propellant
// and ~2.05 t stage-2 propellant; 9 x Rutherford ~26 kN SL (~232 kN total),
// ISP ~303 s (SL) / ~311 s (vac); Rutherford Vacuum ~26 kN / ~343 s;
// throttle to ~60%; payload fairing ~50 kg.

(
    vehicles: [
        (
            name: "Electron",
            diameter_m: 1.2,
            height_m: 18.0,
            stages: [
                (
                    name: "Electron First Stage",
                    dry_mass_kg: 950.0,
                    propellant_mass_kg: 9_250.0,
                    engines: [
                        (
                            position: (0.0, -8.0, 0.0),
                            thrust_axis: (0.0, 1.0, 0.0),
                            isp_sl: 303.0,
                            isp_vac: 311.0,
                            gimbal_range_deg: 4.0,
                            max_thrust_n: 25_800.0,
                            throttle_min: 0.6,
                        ),
                        (
                            position: (0.5, -8.0, 0.0),
                            thrust_axis: (0.0, 1.0, 0.0),
                            isp_sl: 303.0,
                            isp_vac: 311.0,
                            gimbal_range_deg: 4.0,
                            max_thrust_n: 25_800.0,
                            throttle_min: 0.6,
                        ),
                        (
                            position: (0.3535534, -8.0, 0.3535534),
                            thrust_axis: (0.0, 1.0, 0.0),
                            isp_sl: 303.0,
                            isp_vac: 311.0,
                            gimbal_range_deg: 4.0,
                            max_thrust_n: 25_800.0,
                            throttle_min: 0.6,
                        ),
                        (
                            position: (0.0, -8.0, 0.5),
                            thrust_axis: (0.0, 1.0, 0.0),
                            isp_sl: 303.0,
                            isp_vac: 311.0,
                            gimbal_range_deg: 4.0,
                            max_thrust_n: 25_800.0,
                            throttle_min: 0.6,
                        ),
                        (
                            position: (-0.3535534, -8.0, 0.3535534),
                            thrust_axis: (0.0, 1.0, 0.0),
                            isp_sl: 303.0,
                            isp_vac: 311.0,
                            gimbal_range_deg: 4.0,
                            max_thrust_n: 25_800.0,
                            throttle_min: 0.6,
                        ),
                        (
                            position: (-0.5, -8.0, 0.0),
                            thrust_axis: (0.0, 1.0, 0.0),
                            isp_sl: 303.0,
                            isp_vac: 311.0,
                            gimbal_range_deg: 4.0,
                            max_thrust_n: 25_800.0,
                            throttle_min: 0.6,
                        ),
                        (
                            position: (-0.3535534, -8.0, -0.3535534),
                            thrust_axis: (0.0, 1.0, 0.0),
                            isp_sl: 303.0,
                            isp_vac: 311.0,
                            gimbal_range_deg: 4.0,
                            max_thrust_n: 25_800.0,
                            throttle_min: 0.6,
                        ),
                        (
                            position: (0.0, -8.0, -0.5),
                            thrust_axis: (0.0, 1.0, 0.0),
                            isp_sl: 303.0,
                            isp_vac: 311.0,
                            gimbal_range_deg: 4.0,
                            max_thrust_n: 25_800.0,
                            throttle_min: 0.6,
                        ),
                        (
                            position: (0.3535534, -8.0, -0.3535534),
                            thrust_axis: (0.0, 1.0, 0.0),
                            isp_sl: 303.0,
                            isp_vac: 311.0,
                            gimbal_range_deg: 4.0,
                            max_thrust_n: 25_800.0,
                            throttle_min: 0.6,
                        ),
                    ],
                ),
                (
                    name: "Electron Second Stage",
                    dry_mass_kg: 250.0,
                    propellant_mass_kg: 2_050.0,
                    engines: [
                        // Single Rutherford Vacuum.
                        (
                            position: (0.0, 6.0, 0.0),
                            thrust_axis: (0.0, 1.0, 0.0),
                            isp_sl: 311.0,
                            isp_vac: 343.0,
                            gimbal_range_deg: 4.0,
                            max_thrust_n: 25_800.0,
                            throttle_min: 0.6,
                        ),
                    ],
                ),
            ],
            fairing: (
                dry_mass_kg: 50.0,
            ),
        ),
    ],
)
