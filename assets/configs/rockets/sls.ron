// Space Launch System (Block 1) with parallel five-segment SRBs.
//
// NASA's Artemis II SLS Reference Guide (January 2026):
// https://www.nasa.gov/wp-content/uploads/2026/01/sls-5558-artemis-ii-sls-reference-guide-final-review-508-012026.pdf
// The page states that Block 1 uses twin five-segment boosters, each 177 ft
// tall, 12 ft in diameter, weighing 1.6 million lb and producing a maximum
// 3.6 million lbf at launch. This catalog rounds those to 54 m, 3.66 m,
// 725,000 kg gross, and 16.0 MN. The 100 t dry / 625 t propellant split,
// 269/275 s representative Isp, attachment stations, core, ICPS, adapters,
// and other hardware remain configured approximations, not NASA-asserted
// precision. Ignition budgets are conservative catalog assumptions for this
// simulator, not source-verified operational limits.

(
    vehicles: [
        (
            name: "SLS Block 1",
            basis: Representative,
            provenance: (
                manufacturer: "NASA",
                primary_source: (
                    title: "Artemis II SLS Reference Guide",
                    version: "January 2026",
                    publication_date: "2026-01",
                    source_url: "https://www.nasa.gov/wp-content/uploads/2026/01/sls-5558-artemis-ii-sls-reference-guide-final-review-508-012026.pdf",
                ),
                representative_rationale: "The NASA guide informs the public envelope, while configured mass splits, engine stations, ignition limits, and ICPS values remain simulator approximations.",
            ),
            diameter_m: 8.4,
            height_m: 98.0,
            parallel_boosters: (
                basis: Representative,
                count: 2,
                stage: (
                    name: "5-Segment SRB",
                    basis: Representative,
                    diameter_m: 3.66,
                    height_m: 54.0,
                    dry_mass_kg: 100_000.0,
                    propellant_mass_kg: 625_000.0,
                    engines: (
                        basis: Representative,
                        values: [(
                        // Booster-local station at the SRB lower end; it is
                        // translated through its own attachment, never by a
                        // core/full-stack engine station.
                        position: (0.0, -27.0, 0.0),
                        thrust_axis: (0.0, 1.0, 0.0),
                        isp_sl: 269.0,
                        isp_vac: 275.0,
                        gimbal_range_deg: 0.0,
                        rated_thrust_n: 16_000_000.0,
                        thrust_reference: SeaLevel,
                        throttle_min: 1.0,
                        max_ignitions: 1,
                        )],
                    ),
                ),
                // Cylinder origins in the complete stack frame. The core
                // center is y=-16.5 m in the 98 m stack; +/-X is symmetric.
                attachment_positions: [(-6.1, -16.5, 0.0), (6.1, -16.5, 0.0)],
            ),
            stages: [
                (
                    name: "Core Stage",
                    basis: Representative,
                    diameter_m: 8.4,
                    height_m: 65.0,
                    dry_mass_kg: 85_000.0,
                    propellant_mass_kg: 979_000.0,
                    engines: (
                        basis: Representative,
                        values: [
                        // Four RS-25s in a square cluster under the core.
                        // SSMEs cannot restart after separation.
                        (
                            position: (2.0, -32.5, 2.0),
                            thrust_axis: (0.0, 1.0, 0.0),
                            isp_sl: 366.0,
                            isp_vac: 452.0,
                            gimbal_range_deg: 10.5,
                            rated_thrust_n: 2_210_000.0,
                            thrust_reference: Vacuum,
                            throttle_min: 0.67,
                            max_ignitions: 1,
                        ),
                        (
                            position: (-2.0, -32.5, 2.0),
                            thrust_axis: (0.0, 1.0, 0.0),
                            isp_sl: 366.0,
                            isp_vac: 452.0,
                            gimbal_range_deg: 10.5,
                            rated_thrust_n: 2_210_000.0,
                            thrust_reference: Vacuum,
                            throttle_min: 0.67,
                            max_ignitions: 1,
                        ),
                        (
                            position: (2.0, -32.5, -2.0),
                            thrust_axis: (0.0, 1.0, 0.0),
                            isp_sl: 366.0,
                            isp_vac: 452.0,
                            gimbal_range_deg: 10.5,
                            rated_thrust_n: 2_210_000.0,
                            thrust_reference: Vacuum,
                            throttle_min: 0.67,
                            max_ignitions: 1,
                        ),
                        (
                            position: (-2.0, -32.5, -2.0),
                            thrust_axis: (0.0, 1.0, 0.0),
                            isp_sl: 366.0,
                            isp_vac: 452.0,
                            gimbal_range_deg: 10.5,
                            rated_thrust_n: 2_210_000.0,
                            thrust_reference: Vacuum,
                            throttle_min: 0.67,
                            max_ignitions: 1,
                        ),
                        ],
                    ),
                ),
                (
                    name: "ICPS",
                    basis: Representative,
                    diameter_m: 5.1,
                    height_m: 13.7,
                    dry_mass_kg: 3_500.0,
                    propellant_mass_kg: 27_200.0,
                    engines: (
                        basis: Representative,
                        values: [
                        // Single RL10-class cryogenic engine, fixed thrust.
                        (
                            position: (0.0, -6.85, 0.0),
                            thrust_axis: (0.0, 1.0, 0.0),
                            isp_sl: 400.0,
                            isp_vac: 450.0,
                            gimbal_range_deg: 2.0,
                            rated_thrust_n: 110_000.0,
                            thrust_reference: Vacuum,
                            throttle_min: 1.0,
                            max_ignitions: 2,
                        ),
                        ],
                    ),
                ),
            ],
        ),
    ],
)
