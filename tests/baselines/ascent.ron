(
    name: "ascent",
    git_commit: "4a0aef5",
    audit: (
        change_description: "use geometric cylinder centers as rocket positions and evaluate terrain contact at the lower cylindrical extent",
        expected_improvement: "keeps spawned, separated, and recovered rocket geometry consistent with the authoritative stage-centered physics frame",
        numerical_tradeoffs: "the canonical ascent position moves radially by 7.809656793 m after fixed tick 2; semi-implicit Euler, f64 integration, controls, and velocity remain unchanged",
        affected_scenarios: [
            "ascent",
            "KSC launch contact and ascent",
            "drone-ship recovery contact",
        ],
        affected_external_case_ids: [
            ("earth-ssb-j2000-de441"),
        ],
        intended_baseline_divergence: Expected(
            description: "The corrected cylinder-center state and lower-extent terrain contact raise the canonical ascent by 7.809656793 m without changing its velocity trajectory.",
        ),
        scientific_acceptance_output: Unverified(
            reason: "The deterministic ascent fixture verifies internal consistency only; no external launch-trajectory reference was evaluated for this stage-centered contact correction.",
        ),
        reviewer_approved: true,
        recorded_by: "opencode-determinism",
    ),
