(
    name: "ascent",
    git_commit: "4b6c644",
    audit: (
        change_description: "align WGS-84 launch sites with radial cube-sphere terrain coordinates",
        expected_improvement: "keeps the launch pad, collision surface, rocket spawn, and streamed terrain at one KSC direction",
        numerical_tradeoffs: "the KSC trajectory shifts 0.16135 degrees south (~17.9 km); semi-implicit Euler and f64 fixed-step integration are unchanged",
        affected_scenarios: [
            "ascent",
            "KSC launch contact",
        ],
        affected_external_case_ids: [
            ("earth-ssb-j2000-de441"),
        ],
        intended_baseline_divergence: Expected(
            description: "The corrected WGS-84-to-radial terrain mapping changes the canonical launch direction and its derived ascent trajectory.",
        ),
        scientific_acceptance_output: Unverified(
            reason: "The deterministic ascent fixture verifies internal consistency only; no external launch-trajectory reference was evaluated for this terrain-coordinate correction.",
        ),
        reviewer_approved: true,
        recorded_by: "opencode-determinism",
    ),
