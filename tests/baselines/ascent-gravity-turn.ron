(
    name: "ascent-gravity-turn",
    git_commit: "uncommitted",
    audit: (
        change_description: "add a deterministic gravity-turn regression recording for the existing Electron-like fixed-step ascent harness",
        expected_improvement: "extends regression coverage from liftoff and throttle slew through the established vertical gate and gravity-turn entry",
        numerical_tradeoffs: "records the existing f64 semi-implicit fixed-step trajectory for 1,280 ticks without changing physics, tolerances, or control behavior",
        affected_scenarios: [
            "ascent-gravity-turn",
            "KSC launch guidance gate",
            "Electron-like ascent",
        ],
        affected_external_case_ids: [
            ("earth-ssb-j2000-de441"),
        ],
        intended_baseline_divergence: Expected(
            description: "new deterministic scenario; no predecessor recording exists",
        ),
        scientific_acceptance_output: Unverified(
            reason: "this internal trajectory recording is not an external launch-trajectory accuracy claim",
        ),
        reviewer_approved: true,
        recorded_by: "opencode-determinism",
    ),
